{
  "name": "chatendar",
  "version": "1.0.0",
  "description": "Erinnerungsbot: liest Termine aus einem Kalender und schickt Sammel-Erinnerungen an WhatsApp-Ziele",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dry-run": "node src/index.js --dry-run",
    "pair": "node src/pair.js",
    "keepalive": "node src/index.js --keepalive",
    "settings": "node src/settings/server.js",
    "test": "node --test \"test/*.test.js\""
  },
  "keywords": [
    "whatsapp",
    "calendar",
    "ics",
    "reminder",
    "baileys"
  ],
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "baileys-antiban": "4.10.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "node-ical": "^0.20.1",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "tsdav": "^2.3.3"
  }
}
