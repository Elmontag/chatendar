# ─────────────────────────────────────────────────────────────────────────────
# chatendar – Beispielkonfiguration
#
# Diese Datei nach ".env" kopieren und anpassen:
#     cp .env.example .env
#
# Alle Werte sind optional – die hier gezeigten Werte sind die Defaults.
# Alternativ lässt sich alles auch in einer config.json hinterlegen
# (Umgebungsvariablen haben Vorrang vor der config.json).
# ─────────────────────────────────────────────────────────────────────────────

# ── Kalenderquelle ───────────────────────────────────────────────────────────

# "file"   = lokale ICS-Datei (aktuell einzige Implementierung)
# "caldav" = CalDAV/Nextcloud (Schnittstelle vorbereitet, noch nicht umgesetzt)
SOURCE=file

# Pfad zur ICS-Datei (nur bei SOURCE=file), relativ zum Projektverzeichnis
ICS_PATH=./test/fixtures/beispiel.ics

# Zugangsdaten für SOURCE=caldav (aktuell noch ohne Wirkung)
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_CALENDAR=

# Wie weit in die Zukunft Termine gelesen werden. Muss größer sein als die
# längste Vorlaufzeit, sonst wird ein Termin zu spät gesehen.
LOOKAHEAD_DAYS=90


# ── Terminselektion ──────────────────────────────────────────────────────────
# Nur markierte Termine werden verschickt. Beide Wege sind einzeln oder
# gemeinsam nutzbar; ein Treffer genügt (ODER-Verknüpfung).

# Sind BEIDE Wege auf false, ist die Selektion deaktiviert: dann gilt JEDER
# Termin des Kalenders als markiert. Sinnvoll für einen dedizierten Kalender,
# in dem ohnehin nur Termine für die Gruppe stehen.

# Weg 1: Kategorie/Tag im Kalendereintrag (ICS: CATEGORIES)
SELECT_BY_CATEGORY=true
SELECT_CATEGORY=WhatsApp

# Weg 2: Präfix im Titel (ICS: SUMMARY)
SELECT_BY_PREFIX=true
SELECT_PREFIX=[WA]

# Präfix aus dem Titel entfernen, bevor die Nachricht gebaut wird
STRIP_PREFIX=true


# ── Vorlaufzeiten ────────────────────────────────────────────────────────────

# Globale Vorauswahl, kommasepariert. Einheiten: w (Wochen), d (Tage),
# h (Stunden), m (Minuten). Beispiele: 1d,2h  /  1w,30m  /  1d12h
DEFAULT_REMINDERS=1d,2h

# Maximale Anzahl Vorlaufzeiten pro Termin. Werden mehr angegeben, gelten
# die zuerst genannten und es erscheint eine Warnung im Log.
MAX_REMINDERS=2

# ICS-Property, mit der ein einzelner Termin die Defaults überschreibt.
# Im Kalendereintrag z. B.:  X-WA-REMIND:1d,2h
REMINDER_PROPERTY=X-WA-REMIND

# Prüffenster in Minuten: Eine Erinnerung gilt als fällig, wenn ihr
# Versandzeitpunkt zwischen "jetzt - CHECK_WINDOW_MINUTES" und "jetzt" liegt.
# Faustregel: mindestens so groß wie das Cron-Intervall, besser das Doppelte.
CHECK_WINDOW_MINUTES=60

# true = Erinnerungen, deren Versandzeitpunkt vor dem Prüffenster liegt,
#        werden trotzdem nachgeholt (solange der Termin noch bevorsteht).
# false = sie entfallen und werden im State als "missed" vermerkt.
CATCH_UP=false


# ── Darstellung ──────────────────────────────────────────────────────────────

TIMEZONE=Europe/Berlin
LOCALE=de-DE

# Text für {ort}, wenn der Termin keinen Ort hat. Leer lassen, damit
# {?ort}-Abschnitte im Template komplett entfallen.
LOCATION_FALLBACK=


# ── Nachrichten-Templates ────────────────────────────────────────────────────
#
# Platzhalter:
#   {titel}        Titel des Termins (ggf. ohne Präfix)
#   {datum}        z. B. "So., 20.09.2026"
#   {datum_kurz}   z. B. "20.09.2026"
#   {wochentag}    z. B. "Sonntag"
#   {uhrzeit}      z. B. "18:30" (leer bei ganztägigen Terminen)
#   {ort}          Ort des Termins (leer, wenn nicht gesetzt)
#   {ganztag}      "ganztägig" bei ganztägigen Terminen, sonst leer
#   {vorlauf}      z. B. "1 Tag" / "2 Stunden"
#   {vorlauf_kurz} z. B. "1d" / "2h"
#   {items}        nur im Sammel-Template: die gerenderte Terminliste
#   {anzahl}       nur im Sammel-Template: Anzahl der Termine
#
# Bedingte Abschnitte: {?platzhalter}...{/platzhalter} wird nur ausgegeben,
# wenn der Platzhalter einen Wert hat. So verschwindet z. B. die Ortszeile
# automatisch, wenn kein Ort hinterlegt ist.
#
# "\n" im Wert wird zu einem echten Zeilenumbruch.
# WhatsApp-Formatierung: *fett*, _kursiv_, ```Monospace```

TEMPLATE_SINGLE=🔔 *Erinnerung* ({vorlauf} vorher)\n\n*{titel}*\n🗓 {datum}{?uhrzeit}, {uhrzeit} Uhr{/uhrzeit}{?ganztag} (ganztägig){/ganztag}{?ort}\n📍 {ort}{/ort}

TEMPLATE_COLLECTION=🔔 *Erinnerung* ({vorlauf} vorher) – {anzahl} Termine:\n\n{items}

TEMPLATE_COLLECTION_ITEM=• *{titel}*\n  🗓 {datum}{?uhrzeit}, {uhrzeit} Uhr{/uhrzeit}{?ganztag} (ganztägig){/ganztag}{?ort}\n  📍 {ort}{/ort}

# Trenner zwischen den Einträgen im Sammel-Template
COLLECTION_SEPARATOR=\n\n


# ── Wochenübersicht ──────────────────────────────────────────────────────────
# Zusätzlich zu den Einzel-Erinnerungen kann zu einem festen Wochentermin eine
# Liste aller Termine der kommenden Woche verschickt werden.

DIGEST_ENABLED=false

# Wochentag: mo, di, mi, do, fr, sa, so (auch "Freitag", "friday" oder 0-6)
DIGEST_DAY=fr

# Uhrzeit in TIMEZONE. Damit sie getroffen wird, muss das Tool um diese Zeit
# auch laufen – CHECK_WINDOW_MINUTES gilt hier genauso.
DIGEST_TIME=18:00

# Welcher Zeitraum in der Liste steht:
#   7d          rollierend, ab dem Versandzeitpunkt sieben Tage voraus
#   14d, 10d …  beliebiger anderer rollierender Zeitraum
#   next-week   die nächste volle Kalenderwoche (Montag bis Sonntag)
DIGEST_RANGE=7d

# true = Übersicht auch dann senden, wenn kein Termin ansteht
DIGEST_SEND_WHEN_EMPTY=false

# Templates der Übersicht. Zusätzliche Platzhalter:
#   {zeitraum}  z. B. "21.09. – 27.09.2026"
#   {anzahl}    Anzahl der Termine
#   {items}     die gerenderte Terminliste
# Im Item-Template stehen dieselben Termin-Platzhalter zur Verfügung wie in
# den Erinnerungs-Templates ({titel}, {datum}, {uhrzeit}, {ort}, …).
TEMPLATE_DIGEST=🗓 *Termine der kommenden Woche* ({zeitraum})\n\n{items}
TEMPLATE_DIGEST_ITEM=• *{wochentag}, {datum_kurz}*{?uhrzeit} – {uhrzeit} Uhr{/uhrzeit}{?ganztag} – ganztägig{/ganztag}\n  {titel}{?ort} (📍 {ort}){/ort}
TEMPLATE_DIGEST_EMPTY=🗓 *Termine der kommenden Woche* ({zeitraum})\n\nKeine Termine.

# Trenner zwischen den Einträgen der Übersicht
DIGEST_SEPARATOR=\n


# ── WhatsApp ─────────────────────────────────────────────────────────────────

# Ziel-Gruppe. Die ID endet immer auf "@g.us" und lässt sich mit
# "npm run pair" auflisten.
WHATSAPP_GROUP_ID=

# Ablage der Baileys-Session. NIEMALS ins Git-Repo – enthält vollen
# Zugriff auf den gekoppelten WhatsApp-Account. Sichern und Rechte auf 700.
AUTH_DIR=./auth_session

# true = Nachrichten werden nur geloggt, nicht gesendet (sicherer Default)
DRY_RUN=true

# true = auch Dry-Runs werden im State vermerkt. Normalerweise false,
# damit sich ein Testlauf beliebig oft wiederholen lässt.
RECORD_DRY_RUN=false

# Timeout für den Verbindungsaufbau in Millisekunden
CONNECT_TIMEOUT_MS=60000

# Wartezeit vor dem Schließen der Verbindung, damit Nachrichten sicher rausgehen
SEND_DELAY_MS=1500


# ── State ────────────────────────────────────────────────────────────────────

# SQLite-Datei, in der vermerkt wird, welche Erinnerung bereits raus ist.
# Wird diese Datei gelöscht, können alte Erinnerungen erneut verschickt werden.
DB_PATH=./data/reminders.db

# Einträge, die älter sind als X Tage, werden bei jedem Lauf entfernt.
PRUNE_AFTER_DAYS=365


# ── Logging ──────────────────────────────────────────────────────────────────

# debug | info | warn | error
LOG_LEVEL=info
