# ─────────────────────────────────────────────────────────────────────────────
# chatendar – Beispielkonfiguration
#
# Diese Datei nach ".env" kopieren und anpassen:
#     cp .env.example .env
#
# Alternativ: "npm run settings" startet eine lokale Browser-Oberfläche, die
# primär config.json schreibt. Werte aus .env haben weiterhin Vorrang.
#
# Alle Werte sind optional – die hier gezeigten Werte sind die Defaults.
# Alternativ lässt sich alles auch in einer config.json hinterlegen
# (Umgebungsvariablen haben Vorrang vor der config.json).
#
# Für mehrere Kalender/Gruppen empfiehlt sich config.json mit "profiles[]".
# Die klassische Top-Level-Konfiguration bleibt als implizites Profil "default"
# gültig. .env bleibt bei profiles[] idealerweise schlank und enthält höchstens
# lokale Secrets. Jedes Profil hat seinen eigenen vollständigen Einstellungsstack
# und ein whatsappTargets[]-Array; ein vollständiges Beispiel steht in der README.
# ─────────────────────────────────────────────────────────────────────────────

# ── Kalenderquelle ───────────────────────────────────────────────────────────

# "file"   = lokale ICS-Datei
# "caldav" = CalDAV/Nextcloud
SOURCE=file

# Pfad zur ICS-Datei (nur bei SOURCE=file), relativ zum Projektverzeichnis
ICS_PATH=./test/fixtures/beispiel.ics

# Zugangsdaten für SOURCE=caldav
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_CALENDAR=

# Wie weit in die Zukunft Termine gelesen werden. Muss größer sein als die
# längste Vorlaufzeit, sonst wird ein Termin zu spät gesehen.
LOOKAHEAD_DAYS=90


# ── Terminselektion ──────────────────────────────────────────────────────────
# Nur markierte Termine werden verschickt. Beide Wege sind einzeln oder
# gemeinsam nutzbar; ein Treffer genügt (ODER-Verknüpfung).

# Sind BEIDE Wege auf false, ist die Selektion deaktiviert: dann gilt JEDER
# Termin des Kalenders als markiert. Sinnvoll für einen dedizierten Kalender,
# in dem ohnehin nur Termine für die Gruppe stehen.

# Weg 1: Kategorie/Tag im Kalendereintrag (ICS: CATEGORIES)
SELECT_BY_CATEGORY=true
SELECT_CATEGORY=WhatsApp

# Weg 2: Präfix im Titel (ICS: SUMMARY)
SELECT_BY_PREFIX=true
SELECT_PREFIX=[WA]

# Präfix aus dem Titel entfernen, bevor die Nachricht gebaut wird
STRIP_PREFIX=true


# ── Vorlaufzeiten ────────────────────────────────────────────────────────────

# false = keine Einzel- oder Sammelerinnerungen verschicken. Die
# Wochenübersicht wird unabhängig davon über DIGEST_ENABLED gesteuert.
REMINDERS_ENABLED=true

# Globale Vorauswahl, kommasepariert. Einheiten: w (Wochen), d (Tage),
# h (Stunden), m (Minuten). Beispiele: 1d,2h  /  1w,30m  /  1d12h
DEFAULT_REMINDERS=1d,2h

# Maximale Anzahl Vorlaufzeiten pro Termin. Werden mehr angegeben, gelten
# die zuerst genannten und es erscheint eine Warnung im Log.
MAX_REMINDERS=2

# ICS-Property, mit der ein einzelner Termin die Defaults überschreibt.
# Im Kalendereintrag z. B.:  X-WA-REMIND:1d,2h
REMINDER_PROPERTY=X-WA-REMIND

# Prüffenster in Minuten: Eine Erinnerung gilt als fällig, wenn ihr
# Versandzeitpunkt zwischen "jetzt - CHECK_WINDOW_MINUTES" und "jetzt" liegt.
# Faustregel: mindestens so groß wie das Cron-Intervall, besser das Doppelte.
CHECK_WINDOW_MINUTES=60

# true = Erinnerungen, deren Versandzeitpunkt vor dem Prüffenster liegt,
#        werden trotzdem nachgeholt (solange der Termin noch bevorsteht).
# false = sie entfallen und werden im State als "missed" vermerkt.
CATCH_UP=false


# ── Darstellung ──────────────────────────────────────────────────────────────

TIMEZONE=Europe/Berlin
LOCALE=de-DE

# Text für {ort}, wenn der Termin keinen Ort hat. Leer lassen, damit
# {?ort}-Abschnitte im Template komplett entfallen.
LOCATION_FALLBACK=


# ── Nachrichten-Templates ────────────────────────────────────────────────────
#
# Platzhalter:
#   {titel}        Titel des Termins (ggf. ohne Präfix)
#   {tag_relativ}  z. B. "Heute", "Morgen", "Übermorgen", "In 4 Tagen"
#   {tag_relativ_ende} relativer Endtag bei mehrtägigen Terminen
#   {tagesbereich_relativ} z. B. "Morgen" oder "Morgen bis Übermorgen"
#   {datum}        rückwärtskompatibel: z. B. "So., 20.09.2026"
#   {datum_ohne_wochentag} / {datum_kurz} z. B. "20.09.2026"
#   {datum_mit_wochentag} z. B. "Sonntag, 20.09.2026"
#   {datum_mit_wochentag_kurz} z. B. "So., 20.09.2026"
#   {datum_relativ} z. B. "Morgen, So., 20.09.2026"
#   {datumsbereich} nur Datum/Datumsbereich, z. B. "20.09.2026" oder "20.09.2026–22.09.2026"
#   {datumsbereich_mit_wochentag} z. B. "Sonntag, 20.09.2026 – Dienstag, 22.09.2026"
#   {datumsbereich_mit_wochentag_kurz} z. B. "So., 20.09.2026 – Di., 22.09.2026"
#   {termin_zeitraum} kompletter rückwärtskompatibler Zeitraum inkl. relativem Tag und Uhrzeit
#   {termin_zeit}   z. B. "18:30–20:00 Uhr" (leer bei ganztägigen Terminen)
#   {wochentag}    z. B. "Sonntag"
#   {wochentag_kurz} z. B. "So."
#   {uhrzeit}      z. B. "18:30" (leer bei ganztägigen Terminen)
#   {ort}          Ort des Termins (leer, wenn nicht gesetzt)
#   {vorlauf}      z. B. "1 Tag" / "2 Stunden"
#   {vorlauf_kurz} z. B. "1d" / "2h"
#   {items}        nur im Sammel-Template: die gerenderte Terminliste
#   {anzahl}       nur im Sammel-Template: Anzahl der Termine
#
# Bedingte Abschnitte: {?platzhalter}...{/platzhalter} wird nur ausgegeben,
# wenn der Platzhalter einen Wert hat. So verschwindet z. B. die Ortszeile
# automatisch, wenn kein Ort hinterlegt ist.
#
# "\n" im Wert wird zu einem echten Zeilenumbruch.
# WhatsApp-Formatierung: *fett*, _kursiv_, ```Monospace```

TEMPLATE_SINGLE=Kurzer Reminder ({vorlauf} vorher): *{titel}*\n🗓 {tagesbereich_relativ}, {datumsbereich}{?termin_zeit} um {termin_zeit}{/termin_zeit}{?ort}\n📍 {ort}{/ort}\n\nKommt gut hin 🙂

TEMPLATE_COLLECTION=Kurzer Reminder: {anzahl} Termine: {vorlauf} vorher\n\n{items}

TEMPLATE_COLLECTION_ITEM=• {tagesbereich_relativ}, {datumsbereich}{?termin_zeit} um {termin_zeit}{/termin_zeit}: *{titel}*{?ort}\n  📍 {ort}{/ort}

# Trenner zwischen den Einträgen im Sammel-Template
COLLECTION_SEPARATOR=\n\n


# ── Wochenübersicht ──────────────────────────────────────────────────────────
# Unabhängig von REMINDERS_ENABLED kann zu einem festen Wochentermin eine Liste
# aller Termine der kommenden Woche verschickt werden.

DIGEST_ENABLED=false

# Wochentag: mo, di, mi, do, fr, sa, so (auch "Freitag", "friday" oder 0-6)
DIGEST_DAY=fr

# Uhrzeit in TIMEZONE. Damit sie getroffen wird, muss das Tool um diese Zeit
# auch laufen – CHECK_WINDOW_MINUTES gilt hier genauso.
DIGEST_TIME=18:00

# Welcher Zeitraum in der Liste steht:
#   7d          rollierend, ab dem Versandzeitpunkt sieben Tage voraus
#   14d, 10d …  beliebiger anderer rollierender Zeitraum
#   next-week   die nächste volle Kalenderwoche (Montag bis Sonntag)
DIGEST_RANGE=7d

# true = Übersicht auch dann senden, wenn kein Termin ansteht
DIGEST_SEND_WHEN_EMPTY=false

# Templates der Übersicht. Zusätzliche Platzhalter:
#   {zeitraum}  z. B. "21.09. – 27.09.2026"
#   {anzahl}    Anzahl der Termine
#   {items}     die gerenderte Terminliste
# Im Item-Template stehen dieselben Termin-Platzhalter zur Verfügung wie in
# den Erinnerungs-Templates ({titel}, {datum}, {uhrzeit}, {ort}, …).
TEMPLATE_DIGEST=Hier kommt der kurze Blick auf die Termine der kommenden Woche ({zeitraum}):\n\n{items}
TEMPLATE_DIGEST_ITEM=• {tagesbereich_relativ}, {datumsbereich}{?termin_zeit} um {termin_zeit}{/termin_zeit}: *{titel}*{?ort} (📍 {ort}){/ort}
TEMPLATE_DIGEST_EMPTY=Keine Termine für {zeitraum} im Kalender. Sieht entspannt aus 🙂

# Trenner zwischen den Einträgen der Übersicht
DIGEST_SEPARATOR=\n


# ── WhatsApp ─────────────────────────────────────────────────────────────────

# Ziel-Gruppe für die klassische Top-Level-Konfiguration (implizites Profil
# "default"). Die ID endet immer auf "@g.us" und lässt sich mit "npm run pair"
# auflisten. Bei profiles[] in config.json stattdessen pro Profil
# whatsappTargets[] verwenden; alle aktivierten Ziele erhalten dieselbe
# gerenderte Nachricht.
WHATSAPP_GROUP_ID=

# Optionale Einzelperson für die klassische Top-Level-Konfiguration. Immer mit
# internationaler Ländervorwahl angeben. Sind Gruppe und Person gesetzt,
# erhalten beide dieselbe Nachricht.
WHATSAPP_PHONE=

# Ablage der Baileys-Session. NIEMALS ins Git-Repo – enthält vollen
# Zugriff auf den gekoppelten WhatsApp-Account. Sichern und Rechte auf 700.
AUTH_DIR=./auth_session

# true = Nachrichten werden nur geloggt, nicht gesendet (sicherer Default)
DRY_RUN=true

# true = auch Dry-Runs werden im State vermerkt. Normalerweise false,
# damit sich ein Testlauf beliebig oft wiederholen lässt.
RECORD_DRY_RUN=false

# true = konservatives Rate-Limit mit zufälligen Sendeabständen sowie
# Session-/Disconnect-Überwachung. Ändert keine Nachrichten und ist keine
# Garantie gegen WhatsApp-Sperren.
ANTIBAN_ENABLED=true

# Timeout für den Verbindungsaufbau in Millisekunden
CONNECT_TIMEOUT_MS=60000

# Minimaler und maximaler zufälliger Abstand vor jedem Sendevorgang
SEND_DELAY_MS=1500
SEND_DELAY_MAX_MS=7000

# Nach dem letzten Senden so lange (max., in ms) auf die Zustellbestätigung des
# Empfängers warten, bevor die Verbindung geschlossen wird. Nur so kann der Bot
# Entschlüsselungs-Retries beantworten – sonst sieht der Empfänger "Warte auf
# diese Nachricht". 0 = sofort schließen (nicht empfohlen).
SEND_SETTLE_MS=10000

# Keepalive: Wenn so viele Tage lang keine WhatsApp-Verbindung bestand (z. B. weil
# nichts zu senden war), öffnet der nächste Lauf sie kurz ohne zu senden. Hält die
# Session in Benutzung und meldet eine Abmeldung früh über den Exit-Code.
# 0 = aus. Manuell: npm run keepalive
KEEPALIVE_DAYS=7

# Sicherungen von AUTH_DIR: bis zu einmal täglich nach erfolgreicher Verbindung.
# SESSION_BACKUP_KEEP = Anzahl aufbewahrter Sicherungen (0 = aus). Der Ordner
# sollte auf einem anderen Laufwerk liegen. Sicherungen enthalten Vollzugriff auf
# das WhatsApp-Konto und dürfen nicht ins Repo oder in eine Cloud-Synchronisation.
SESSION_BACKUP_KEEP=7
SESSION_BACKUP_DIR=./data/session-backups

# Fehlersuche: Baileys-Protokoll mitschreiben (debug | trace). Standard: aus.
# Die Datei enthält Rufnummern und gehört nicht ins Repo.
#BAILEYS_LOG_LEVEL=debug
#BAILEYS_LOG_FILE=./data/baileys.log


# ── State ────────────────────────────────────────────────────────────────────

# SQLite-Datei, in der vermerkt wird, welche Erinnerung bereits raus ist.
# Bei profiles[] wird nach Profil-ID und WhatsApp-Ziel getrennt, damit ein
# Versand an Ziel A niemals Ziel B unterdrückt. Alte Datenbanken werden
# beim ersten Start automatisch migriert; alte Zeilen erhalten profile_id=
# "default" und target_id="default".
# Wird diese Datei gelöscht, können alte Erinnerungen erneut verschickt werden.
DB_PATH=./data/reminders.db

# Einträge, die älter sind als X Tage, werden bei jedem Lauf entfernt.
PRUNE_AFTER_DAYS=365


# ── Logging ──────────────────────────────────────────────────────────────────

# debug | info | warn | error
LOG_LEVEL=info
